#!/usr/bin/env bash
set -Eeuo pipefail

MODE=1296p56
VERIFY=no
VERIFY_FRAMES=112

usage() {
  cat >&2 <<USAGE
Usage: $0 [--mode 1296p56|864p120] [--verify-stream] [--verify-frames N]
USAGE
  exit 2
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    --mode) MODE=${2:?missing mode}; shift 2 ;;
    --verify-stream) VERIFY=yes; shift ;;
    --verify-frames) VERIFY_FRAMES=${2:?missing frame count}; shift 2 ;;
    -h|--help) usage ;;
    *) usage ;;
  esac
done

case "$MODE" in
  1296p56)
    WIDTH=2304; HEIGHT=1296; FPS=56; VBLANK=40
    ;;
  864p120)
    WIDTH=1536; HEIGHT=864; FPS=120; VBLANK=40
    ;;
  *) echo "Unsupported mode: $MODE" >&2; usage ;;
esac

for cmd in media-ctl v4l2-ctl grep awk sed ln mkdir; do
  command -v "$cmd" >/dev/null || { echo "Missing required command: $cmd" >&2; exit 1; }
done

find_media() {
  local m
  for m in /dev/media*; do
    [[ -e "$m" ]] || continue
    if media-ctl -d "$m" -p 2>/dev/null | grep -qE 'entity [0-9]+: imx708( |$)'; then
      printf '%s\n' "$m"
      return 0
    fi
  done
  return 1
}

entity_dev() {
  local entity=$1
  media-ctl -d "$MEDIA" -e "$entity" 2>/dev/null | tail -n1
}

MEDIA=$(find_media) || {
  echo "No media graph containing an imx708 sensor was found." >&2
  exit 1
}

SENSOR_ENTITY=imx708
BRIDGE_ENTITY=cdns_csi2rx.30101000.csi-bridge
CSI_ENTITY=30102000.ticsi2rx
CTX_ENTITY='30102000.ticsi2rx context 0'

SENSOR_DEV=$(entity_dev "$SENSOR_ENTITY")
VIDEO_DEV=$(entity_dev "$CTX_ENTITY")

[[ "$SENSOR_DEV" == /dev/v4l-subdev* && -e "$SENSOR_DEV" ]] || {
  echo "Could not resolve IMX708 sensor subdev from $MEDIA (got '$SENSOR_DEV')." >&2
  exit 1
}
[[ "$VIDEO_DEV" == /dev/video* && -e "$VIDEO_DEV" ]] || {
  echo "Could not resolve TI CSI2RX context 0 video node from $MEDIA (got '$VIDEO_DEV')." >&2
  exit 1
}

BAYER_MBUS=SRGGB10_1X10
BAYER_V4L2=RG10

# Configure the exact graph qualified on BeagleY-AI CSI0.
media-ctl -d "$MEDIA" --set-v4l2 "\"$SENSOR_ENTITY\":0[fmt:${BAYER_MBUS}/${WIDTH}x${HEIGHT}]"
media-ctl -d "$MEDIA" --set-v4l2 "\"$BRIDGE_ENTITY\":0[fmt:${BAYER_MBUS}/${WIDTH}x${HEIGHT}]"
media-ctl -d "$MEDIA" --set-v4l2 "\"$BRIDGE_ENTITY\":1[fmt:${BAYER_MBUS}/${WIDTH}x${HEIGHT}]"
media-ctl -d "$MEDIA" --set-v4l2 "\"$CSI_ENTITY\":0[fmt:${BAYER_MBUS}/${WIDTH}x${HEIGHT}]"
media-ctl -d "$MEDIA" --set-v4l2 "\"$CSI_ENTITY\":1[fmt:${BAYER_MBUS}/${WIDTH}x${HEIGHT}]"

v4l2-ctl -d "$VIDEO_DEV" --set-fmt-video="width=${WIDTH},height=${HEIGHT},pixelformat=${BAYER_V4L2}" >/dev/null
v4l2-ctl -d "$SENSOR_DEV" --set-ctrl="vertical_blanking=${VBLANK}" >/dev/null

mkdir -p /run/ti-k3
ln -sfn "$VIDEO_DEV" /run/ti-k3/camera-video
ln -sfn "$SENSOR_DEV" /run/ti-k3/camera-subdev

cat > /run/ti-k3/camera.env <<ENV
TI_K3_CAMERA_DETECTED_SENSOR=imx708
TI_K3_CAMERA_SKU=arducam-b0310
TI_K3_CAMERA_MEDIA_DEVICE=$MEDIA
TI_K3_CAMERA_VIDEO_DEVICE=/run/ti-k3/camera-video
TI_K3_CAMERA_VIDEO_DEVICE_REAL=$VIDEO_DEV
TI_K3_CAMERA_SUBDEV_DEVICE=/run/ti-k3/camera-subdev
TI_K3_CAMERA_SUBDEV_DEVICE_REAL=$SENSOR_DEV
TI_K3_CAMERA_MODE=$MODE
TI_K3_CAMERA_WIDTH=$WIDTH
TI_K3_CAMERA_HEIGHT=$HEIGHT
TI_K3_CAMERA_FPS=$FPS
TI_K3_CAMERA_VBLANK=$VBLANK
TI_K3_CAMERA_MBUS_FORMAT=$BAYER_MBUS
TI_K3_CAMERA_V4L2_FORMAT=$BAYER_V4L2
TI_K3_CAMERA_GST_BAYER_FORMAT=rggb10le
TI_K3_CAMERA_GST_V4L2_BAYER_FORMAT=rggb10le
TI_K3_CAMERA_GST_TIOVX_BAYER_FORMAT=rggb10
TI_K3_CAMERA_FORMAT_MSB=9
TI_K3_CAMERA_DCC_COMPAT_SENSOR=SENSOR_SONY_IMX219_RPI
TI_K3_CAMERA_DCC_COMPAT_ID=219
TI_K3_CAMERA_DCC_VISS=/opt/imaging/imx708/linear/dcc_viss_2304x1296.bin
TI_K3_CAMERA_DCC_2A=/opt/imaging/imx708/linear/dcc_2a_2304x1296.bin
ENV

printf 'IMX708 graph configured: media=%s sensor=%s video=%s mode=%s %sx%s@%s RAW10\n' \
  "$MEDIA" "$SENSOR_DEV" "$VIDEO_DEV" "$MODE" "$WIDTH" "$HEIGHT" "$FPS"

if [[ "$VERIFY" == yes ]]; then
  echo "Verifying RAW10 streaming for ${VERIFY_FRAMES} frames..."
  v4l2-ctl -d "$VIDEO_DEV" \
    --stream-mmap=6 \
    --stream-poll \
    --stream-count="$VERIFY_FRAMES" \
    --stream-to=/dev/null
fi
