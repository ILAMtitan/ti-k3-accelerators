#!/usr/bin/env bash
set -Eeuo pipefail
export LC_ALL=C

if [[ ${EUID:-$(id -u)} -ne 0 ]]; then
  echo "Run as root (sudo)." >&2
  exit 1
fi

EDGEAI_GST_REPO=https://github.com/TexasInstruments/edgeai-gst-plugins.git
EDGEAI_GST_COMMIT=fea12213b449fc1ea117ad5f0016c08f417ab46d
SRC=/opt/ti-k3-src/edgeai-gst-plugins-imx708-raw10le-core-r1
BUILD=/tmp/ti-k3-edgeai-gst-plugins-imx708-raw10le-core-r1-build
EDGEAI_LINK_DIR=${BUILD}.ti-edgeai-link
RUNTIME_BASE=/opt/ti-k3/runtime
BASE_ID=ti-11.02.01-j722s-r73341
BASE_RELEASE="$RUNTIME_BASE/releases/$BASE_ID"
NEW_ID=ti-11.02.01-j722s-r73341-imx708-raw10le-core-r1
NEW_RELEASE="$RUNTIME_BASE/releases/$NEW_ID"
EDGEAI_HELPER=/usr/local/sbin/ti-k3-prepare-ti-edgeai-linker-interface
JOBS=${TI_K3_IMAGE_BUILD_JOBS:-$(nproc)}

[[ $JOBS =~ ^[1-9][0-9]*$ ]] || { echo "Invalid build job count: $JOBS" >&2; exit 2; }
for cmd in git meson ninja python3 pkg-config find readelf ldd sha256sum install cp ln mv grep awk cmp sort xargs nproc; do
  command -v "$cmd" >/dev/null || { echo "Missing command: $cmd" >&2; exit 1; }
done
[[ -x $EDGEAI_HELPER ]] || { echo "Missing TI linker-interface helper: $EDGEAI_HELPER" >&2; exit 1; }
[[ -d $BASE_RELEASE ]] || { echo "Missing qualified base runtime: $BASE_RELEASE" >&2; exit 1; }
for header_dir in \
  /usr/include/processor_sdk/tiovx/include \
  /usr/include/processor_sdk/vision_apps \
  /usr/include/processor_sdk/imaging \
  /usr/include/edgeai-tiovx-modules \
  /usr/include/edgeai-tiovx-kernels \
  /usr/include/edgeai-apps-utils; do
  [[ -d $header_dir ]] || { echo "Missing imported TI development headers: $header_dir" >&2; exit 1; }
done

printf 'Fetching pinned TI TIOVX source (core-only rebuild; no TI 2A provider required)...\n'
rm -rf "$SRC" "$BUILD" "$EDGEAI_LINK_DIR"
git init -q "$SRC"
git -C "$SRC" remote add origin "$EDGEAI_GST_REPO"
git -C "$SRC" fetch -q --depth 1 origin "$EDGEAI_GST_COMMIT"
git -C "$SRC" checkout -q --detach FETCH_HEAD
actual_commit=$(git -C "$SRC" rev-parse HEAD)
[[ $actual_commit == "$EDGEAI_GST_COMMIT" ]] || { echo "edgeai-gst-plugins source pin mismatch: $actual_commit" >&2; exit 1; }

UTILS="$SRC/gst-libs/gst/tiovx/gsttiovxutils.c"
[[ -s $UTILS ]] || { echo "Missing TIOVX core source: $UTILS" >&2; exit 1; }

printf 'Adding GStreamer 1.24 RAW10LE aliases to the TIOVX raw-container mapper...\n'
python3 - "$UTILS" <<'PY'
from pathlib import Path
import sys
p=Path(sys.argv[1]); s=p.read_text()
if 'g_str_equal (gst_format, "rggb10le")' not in s:
    old='      g_str_equal (gst_format, "rggb10") ||\n'
    new=(old
         + '      g_str_equal (gst_format, "bggr10le") ||\n'
         + '      g_str_equal (gst_format, "gbrg10le") ||\n'
         + '      g_str_equal (gst_format, "grbg10le") ||\n'
         + '      g_str_equal (gst_format, "rggb10le") ||\n')
    if s.count(old) != 1:
        raise SystemExit(f'Expected one RAW10 mapping insertion point; found {s.count(old)}')
    p.write_text(s.replace(old,new,1))
PY
grep -Fq 'g_str_equal (gst_format, "rggb10le")' "$UTILS"

printf 'Preparing deployed TI linker interface...\n'
"$EDGEAI_HELPER" "$EDGEAI_LINK_DIR" /lib /usr/lib /usr/local/lib

gst_plugin_dir=$(pkg-config --variable=pluginsdir gstreamer-1.0)
[[ $gst_plugin_dir == /usr/*/gstreamer-1.0 ]] || { echo "Unexpected GStreamer plugin directory: $gst_plugin_dir" >&2; exit 1; }
libdir=${gst_plugin_dir#/usr/}; libdir=${libdir%/gstreamer-1.0}

export SOC=j722s
export PKG_CONFIG_PATH="$SRC/pkgconfig${PKG_CONFIG_PATH:+:$PKG_CONFIG_PATH}"
export CFLAGS="${CFLAGS:-} -I/usr/include/processor_sdk/tiovx/include -I/usr/include/processor_sdk/vision_apps -I/usr/include/processor_sdk/imaging -I/usr/include/edgeai-tiovx-modules -I/usr/include/edgeai-tiovx-kernels -I/usr/include/edgeai-apps-utils"
export CXXFLAGS="$CFLAGS"
export LIBRARY_PATH="$EDGEAI_LINK_DIR:$RUNTIME_BASE/current/ti${LIBRARY_PATH:+:$LIBRARY_PATH}"
export LDFLAGS="${LDFLAGS:-} -L$EDGEAI_LINK_DIR -L$RUNTIME_BASE/current/ti -Wl,-rpath-link,$EDGEAI_LINK_DIR -Wl,-rpath-link,$RUNTIME_BASE/current/ti"

printf 'Configuring pinned TI source without the full-plugin TI 2A build dependency...\n'
meson setup "$BUILD" "$SRC" \
  --buildtype=debugoptimized --wrap-mode=nodownload --prefix=/usr --libdir="$libdir" \
  -Dtests=disabled -Dexamples=disabled -Ddoc=disabled -Dprofiling=disabled \
  -Ddl-plugins=disabled -Denable-tidl=disabled \
  -Dpackage-name='TI K3 TIOVX IMX708 RAW10LE core compatibility build' \
  -Dpackage-origin='TI K3 BeagleY-AI IMX708 live compatibility build'

printf 'Building only libgsttiovx-1.0 core...\n'
meson compile -C "$BUILD" -j "$JOBS" gsttiovx-1.0

mapfile -t cores < <(find "$BUILD/gst-libs/gst/tiovx" -maxdepth 1 -type f -name 'libgsttiovx-1.0.so.*' -print | sort)
(( ${#cores[@]} == 1 )) || {
  printf 'Built TIOVX core candidates:\n' >&2
  printf '  %s\n' "${cores[@]:-none}" >&2
  echo "Expected one real versioned libgsttiovx-1.0 core file; found ${#cores[@]}" >&2
  exit 1
}
CORE=${cores[0]}
CORE_NAME=$(basename "$CORE")
CORE_SONAME=$(readelf -dW "$CORE" | sed -n 's/.*SONAME.*\[\(.*\)\].*/\1/p' | head -n1)
[[ -n $CORE_SONAME ]] || { echo "Could not read TIOVX core SONAME from $CORE" >&2; exit 1; }

printf 'Validating RAW10LE mapping in rebuilt core...\n'
env LD_LIBRARY_PATH="$BUILD/gst-libs/gst/tiovx:$RUNTIME_BASE/current/ti" \
  python3 - "$CORE" <<'PY'
import ctypes, sys
lib=ctypes.CDLL(sys.argv[1])
fn=lib.gst_format_to_tivx_raw_format
fn.argtypes=[ctypes.c_char_p]
fn.restype=ctypes.c_int
legacy=fn(b'rggb10')
modern=fn(b'rggb10le')
if legacy < 0 or modern != legacy:
    raise SystemExit(f'RAW10 mapping validation failed: rggb10={legacy} rggb10le={modern}')
print(f'RAW10 mapping PASS: rggb10={legacy} rggb10le={modern}')
PY

printf 'Publishing isolated IMX708 runtime: %s\n' "$NEW_RELEASE"
rm -rf "$NEW_RELEASE"
cp -a "$BASE_RELEASE" "$NEW_RELEASE"
rm -f "$NEW_RELEASE/ti"/libgsttiovx-1.0.so*
install -m 0755 "$CORE" "$NEW_RELEASE/ti/$CORE_NAME"
if [[ $CORE_SONAME != "$CORE_NAME" ]]; then
  ln -s "$CORE_NAME" "$NEW_RELEASE/ti/$CORE_SONAME"
fi
if [[ $CORE_SONAME != libgsttiovx-1.0.so ]]; then
  ln -s "$CORE_SONAME" "$NEW_RELEASE/ti/libgsttiovx-1.0.so"
fi

BASE_PLUGIN="$BASE_RELEASE/ti/gstreamer-1.0/libgsttiovx.so"
NEW_PLUGIN="$NEW_RELEASE/ti/gstreamer-1.0/libgsttiovx.so"
[[ -s $BASE_PLUGIN && -s $NEW_PLUGIN ]] || { echo "Qualified TIOVX plugin missing from base/new runtime" >&2; exit 1; }
cmp -s "$BASE_PLUGIN" "$NEW_PLUGIN" || { echo "TIOVX plugin unexpectedly changed during core-only publication" >&2; exit 1; }

cat > "$NEW_RELEASE/IMX708-RAW10LE-COMPAT.env" <<META
format=1
base_runtime=$BASE_ID
compatibility=imx708-gstreamer-raw10le-core-alias
pipeline_caps_bridge=rggb10le-to-rggb10
plugin_rebuilt=no
core_rebuilt=yes
tiovx_source_commit=$EDGEAI_GST_COMMIT
plugin_sha256=$(sha256sum "$NEW_PLUGIN" | awk '{print $1}')
core_sha256=$(sha256sum "$NEW_RELEASE/ti/$CORE_NAME" | awk '{print $1}')
META
(
  cd "$NEW_RELEASE"
  find . -type f ! -name SHA256SUMS -print0 | sort -z | xargs -0 sha256sum > SHA256SUMS
  sha256sum -c SHA256SUMS >/dev/null
)

printf 'Checking published runtime relocations...\n'
for obj in "$NEW_PLUGIN" "$NEW_RELEASE/ti/$CORE_NAME"; do
  report=$(env LD_LIBRARY_PATH="$NEW_RELEASE/ti" ldd -r "$obj" 2>&1 || true)
  if grep -Eqi 'not found|undefined symbol' <<<"$report"; then
    printf '%s\n' "$report" >&2
    exit 1
  fi
done

printf 'Switching /opt/ti-k3/runtime/current atomically...\n'
rm -f "$RUNTIME_BASE/current.new"
ln -s "releases/$NEW_ID" "$RUNTIME_BASE/current.new"
mv -Tf "$RUNTIME_BASE/current.new" "$RUNTIME_BASE/current"
rm -f /root/.cache/gstreamer-1.0/registry.*.bin 2>/dev/null || true

set -a
# shellcheck source=/dev/null
source /etc/ti-k3/gstreamer.env
set +a

gst-inspect-1.0 tiovxisp >/dev/null

printf '\nIMX708 RAW10LE TIOVX core compatibility runtime installed.\n'
printf 'current=%s\n' "$(readlink -f "$RUNTIME_BASE/current")"
printf 'plugin_unchanged=%s\n' "$(sha256sum "$NEW_PLUGIN" | awk '{print $1}')"
printf 'core=%s\n' "$(sha256sum "$NEW_RELEASE/ti/$CORE_NAME" | awk '{print $1}')"
printf '\nRollback (if needed):\n  ln -sfn releases/%s /opt/ti-k3/runtime/current\n  rm -f /root/.cache/gstreamer-1.0/registry.*.bin\n' "$BASE_ID"
