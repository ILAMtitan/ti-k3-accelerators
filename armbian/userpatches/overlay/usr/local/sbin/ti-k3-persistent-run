#!/usr/bin/env bash
set -Eeuo pipefail
[[ $# -ge 2 ]] || { echo "Usage: $0 NAME COMMAND [ARG...]" >&2; exit 2; }
name=$1; shift
[[ "$name" =~ ^[A-Za-z0-9_.@+-]+$ ]] || exit 2
root=${TI_K3_PERSISTENT_LOG_ROOT:-/var/lib/ti-k3-validation/boots}
boot_id=$(cat /proc/sys/kernel/random/boot_id 2>/dev/null || printf unknown)
dir="$root/$boot_id"
install -d -m 0755 "$dir"
ln -sfn "$boot_id" "$root/current"
log="$dir/${name}.log"
exec > >(stdbuf -oL -eL tee -a "$log") 2>&1
printf '===== %s start %s =====\n' "$name" "$(date --iso-8601=seconds)"
printf 'command:'; printf ' %q' "$@"; printf '\n'
exec "$@"
