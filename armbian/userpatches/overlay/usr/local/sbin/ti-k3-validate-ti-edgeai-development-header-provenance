#!/usr/bin/env bash
set -Eeuo pipefail
export LC_ALL=C

usage() {
  echo "Usage: $0 SOURCE-BUILD.env ALLOWED-SOURCES.txt [context]" >&2
  exit 2
}
[[ $# -ge 2 && $# -le 3 ]] || usage
meta=$1
allowed=$2
context=${3:-TI development-header provenance}

[[ -s "$meta" ]] || { echo "$context metadata is missing or empty: $meta" >&2; exit 1; }
[[ -s "$allowed" ]] || { echo "$context allowlist is missing or empty: $allowed" >&2; exit 1; }

mapfile -t sources < <(sed -n 's/^development_headers_source=//p' "$meta")
if (( ${#sources[@]} != 1 )); then
  echo "$context must contain exactly one development_headers_source entry; found ${#sources[@]} in $meta" >&2
  exit 1
fi
source_value=${sources[0]}
[[ -n "$source_value" && "$source_value" != *[[:space:]]* ]] || {
  echo "$context contains an invalid development_headers_source value: ${source_value@Q}" >&2
  exit 1
}
if ! grep -Fxq -- "$source_value" "$allowed"; then
  echo "$context uses an unsupported development_headers_source: $source_value" >&2
  echo "Allowed values:" >&2
  sed 's/^/  /' "$allowed" >&2
  exit 1
fi
printf '%s\n' "$source_value"
