#!/usr/bin/env bash
set -Eeuo pipefail

FRAMES=${FRAMES:-600}
OUT=${OUT:-/tmp/imx708-viss-wave5-1280x720p60.h264}
BITRATE=${BITRATE:-6000000}
GOP=${GOP:-30}
IMX708_MODE=864p60
export IMX708_MODE

[[ "$FRAMES" =~ ^[1-9][0-9]*$ ]] || { echo "Invalid FRAMES=$FRAMES" >&2; exit 2; }
[[ "$BITRATE" =~ ^[1-9][0-9]*$ ]] || { echo "Invalid BITRATE=$BITRATE" >&2; exit 2; }
[[ "$GOP" =~ ^[1-9][0-9]*$ ]] || { echo "Invalid GOP=$GOP" >&2; exit 2; }

if [[ $EUID -ne 0 ]]; then
  echo "Run as root (sudo)." >&2
  exit 1
fi

ti-k3-imx708-viss-preflight

set -a
# shellcheck source=/dev/null
source /etc/ti-k3/gstreamer.env
# shellcheck source=/dev/null
source /run/ti-k3/camera.env
set +a

[[ "$TI_K3_CAMERA_MODE" == 864p60 ]] || {
  echo "Expected 864p60 camera contract, got $TI_K3_CAMERA_MODE" >&2
  exit 1
}

for element in tiovxmultiscaler v4l2h264enc h264parse; do
  gst-inspect-1.0 "$element" >/dev/null || { echo "Missing GStreamer element: $element" >&2; exit 1; }
done

rm -f "$OUT"

echo "Running IMX708 1536x864p60 -> VISS -> multiscaler 1280x720p60 -> Wave5 H.264..."

GST_DEBUG=${GST_DEBUG_LEVEL:-2} gst-launch-1.0 -e \
  v4l2src device="$TI_K3_CAMERA_VIDEO_DEVICE" io-mode=dmabuf-import do-timestamp=true num-buffers="$FRAMES" ! \
  "video/x-bayer,format=${TI_K3_CAMERA_GST_V4L2_BAYER_FORMAT},width=1536,height=864,framerate=60/1" ! \
  capssetter caps="video/x-bayer,format=${TI_K3_CAMERA_GST_TIOVX_BAYER_FORMAT}" join=true replace=false ! \
  tiovxisp \
    sensor-name="$TI_K3_CAMERA_DCC_COMPAT_SENSOR" \
    dcc-isp-file="$TI_K3_CAMERA_DCC_VISS" \
    format-msb=9 \
    bypass-cac=true \
    bypass-dwb=true \
    sink_0::dcc-2a-file="$TI_K3_CAMERA_DCC_2A" \
    sink_0::device="$TI_K3_CAMERA_SUBDEV_DEVICE" \
    sink_0::ae-mode=AE_MODE_DISABLED \
    sink_0::awb-mode=AWB_MODE_DISABLED \
    sink_0::pool-size=4 \
    src::pool-size=4 ! \
  video/x-raw,format=NV12,width=1536,height=864,framerate=60/1 ! \
  tiovxmultiscaler target=0 ! \
  video/x-raw,format=NV12,width=1280,height=720,framerate=60/1 ! \
  queue max-size-buffers=1 max-size-bytes=0 max-size-time=0 leaky=downstream ! \
  v4l2h264enc \
    extra-controls="controls,frame_level_rate_control_enable=1,video_bitrate=${BITRATE},video_gop_size=${GOP},prepend_sps_and_pps_to_idr=1" ! \
  video/x-h264,stream-format=byte-stream,alignment=au ! \
  h264parse ! \
  filesink location="$OUT" sync=false

[[ -s "$OUT" ]] || { echo "Wave5 output missing/empty: $OUT" >&2; exit 1; }

ls -lh "$OUT"
sha256sum "$OUT"
echo "IMX708 720p60 Wave5 smoke PASS: $OUT"
