#!/usr/bin/env bash
set -euo pipefail
sensor=imx219
write_env=no
quiet=no
while [[ $# -gt 0 ]]; do
  case "$1" in
    --sensor) sensor=${2:?missing sensor}; shift 2 ;;
    --write-env) write_env=yes; shift ;;
    --quiet) quiet=yes; shift ;;
    *) echo "Usage: $0 [--sensor imx219] [--write-env] [--quiet]" >&2; exit 2 ;;
  esac
done
[[ "$sensor" == imx219 ]] || { echo "Unsupported sensor: $sensor" >&2; exit 2; }
mkdir -p /run/ti-k3

# Load immutable platform-owned camera assets/defaults before publishing the
# application-facing contract. Device discovery may refresh camera.env at any
# time, so every refresh must remain a complete contract.
if [[ -r /etc/ti-k3/accelerators.env ]]; then
  # shellcheck source=/dev/null
  source /etc/ti-k3/accelerators.env
fi

video=""
subdev=""
if [[ -e /dev/video-imx219-cam0 ]]; then video=/dev/video-imx219-cam0; fi
if [[ -e /dev/v4l-imx219-subdev0 ]]; then subdev=/dev/v4l-imx219-subdev0; fi

# Locate the sensor subdevice by its kernel-reported entity name when the
# BeagleBoard stable symlink has not yet been created.
if [[ -z "$subdev" ]]; then
  for node in /sys/class/video4linux/v4l-subdev*; do
    [[ -r "$node/name" ]] || continue
    name=$(tr '[:upper:]' '[:lower:]' <"$node/name")
    if [[ "$name" == *imx219* ]]; then subdev="/dev/${node##*/}"; break; fi
  done
fi

# Prefer capture nodes explicitly named for IMX219. Otherwise select a CSI2RX
# capture node and reject Wave5, JPEG, and codec devices.
if [[ -z "$video" ]]; then
  for node in /sys/class/video4linux/video*; do
    [[ -r "$node/name" ]] || continue
    name=$(tr '[:upper:]' '[:lower:]' <"$node/name")
    case "$name" in
      *imx219*) video="/dev/${node##*/}"; break ;;
    esac
  done
fi
if [[ -z "$video" ]]; then
  for node in /sys/class/video4linux/video*; do
    [[ -r "$node/name" ]] || continue
    name=$(tr '[:upper:]' '[:lower:]' <"$node/name")
    [[ "$name" == *csi2rx* || "$name" == *csi2*rx* ]] || continue
    [[ "$name" == *wave5* || "$name" == *codec* || "$name" == *jpeg* ]] && continue
    dev="/dev/${node##*/}"
    if v4l2-ctl -d "$dev" -D 2>/dev/null | grep -Eq 'Video Capture|Video Capture Multiplanar'; then
      video=$dev
      break
    fi
  done
fi

if [[ -z "$video" || -z "$subdev" ]]; then
  [[ "$quiet" == yes ]] || {
    echo "IMX219 camera devices were not found." >&2
    echo "Load the BeagleY-AI IMX219 overlay, reboot, and run beagle-camera-setup." >&2
  }
  exit 1
fi
ln -sfn "$video" /run/ti-k3/camera-video
ln -sfn "$subdev" /run/ti-k3/camera-subdev

env_file=/run/ti-k3/camera.env
tmp=$(mktemp /run/ti-k3/.camera.env.XXXXXX)
cat >"$tmp" <<EOF_ENV
# Generated by ti-k3-find-camera-devices
TI_K3_CAMERA_DETECTED_SENSOR=imx219
TI_K3_CAMERA_VIDEO_DEVICE=/run/ti-k3/camera-video
TI_K3_CAMERA_SUBDEV_DEVICE=/run/ti-k3/camera-subdev
TI_K3_CAMERA_SENSOR_NAME=SENSOR_SONY_IMX219_RPI
TI_K3_CAMERA_BAYER_FORMAT=rggb
TI_K3_CAMERA_FORMAT_MSB=7
TI_K3_CAMERA_DCC_VISS=${TI_K3_CAMERA_DCC_VISS:-/opt/imaging/imx219/linear/dcc_viss_1920x1080.bin}
TI_K3_CAMERA_DCC_2A=${TI_K3_CAMERA_DCC_2A:-/opt/imaging/imx219/linear/dcc_2a_1920x1080.bin}
TI_K3_CAMERA_CSI_V4L2_IO_MODE=${TI_K3_CAMERA_CSI_V4L2_IO_MODE:-dmabuf-import}
TI_K3_CAMERA_TIOVX_SINK_POOL_SIZE=${TI_K3_CAMERA_TIOVX_SINK_POOL_SIZE:-8}
TI_K3_CAMERA_TIOVX_SRC_POOL_SIZE=${TI_K3_CAMERA_TIOVX_SRC_POOL_SIZE:-8}
EOF_ENV
chmod 0644 "$tmp"
mv -f "$tmp" "$env_file"
if [[ "$write_env" == yes ]]; then
  cat "$env_file"
elif [[ "$quiet" == no ]]; then
  printf 'sensor=%s\nvideo=%s\nsubdev=%s\n' "$sensor" "$video" "$subdev"
fi
