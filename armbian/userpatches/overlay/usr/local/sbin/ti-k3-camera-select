#!/usr/bin/env bash
set -Eeuo pipefail

CONFIG_FILE=${TI_K3_CAMERA_CONFIG_FILE:-/etc/ti-k3/camera.conf}
UENV_FILE=${TI_K3_CAMERA_UENV_FILE:-/boot/uEnv.txt}
DTB_ROOT=${TI_K3_DTB_ROOT:-/boot/dtb}
RUN_ENV=${TI_K3_CAMERA_RUN_ENV:-/run/ti-k3/camera.env}

usage() {
  cat >&2 <<'USAGE'
Usage:
  ti-k3-camera-select imx219|imx708|imx415
  ti-k3-camera-select status
  ti-k3-camera-select list

Selects the BeagleY-AI CSI camera for the next boot. Camera selection is a
boot-time operation because each sensor requires a different device-tree
overlay. A reboot is required only when the active boot overlay changes.
USAGE
  exit 2
}

overlay_for() {
  case "$1" in
    imx219) printf '%s\n' 'ti/k3-am67a-beagley-ai-csi1-imx219.dtbo' ;;
    imx708) printf '%s\n' 'ti/k3-am67a-beagley-ai-csi0-arducam-b0310.dtbo' ;;
    imx415) printf '%s\n' 'ti/k3-am67a-beagley-ai-csi0-arducam-b0569-imx415-37.dtbo' ;;
    *) return 1 ;;
  esac
}

camera_type_for() {
  case "$1" in
    imx219) printf '%s\n' 150 ;;
    imx708) printf '%s\n' 151 ;;
    imx415) printf '%s\n' 152 ;;
    *) return 1 ;;
  esac
}

known_camera_basename() {
  case "$1" in
    k3-am67a-beagley-ai-csi1-imx219.dtbo|\
    k3-am67a-beagley-ai-csi0-imx219.dtbo|\
    k3-am67a-beagley-ai-csi0-arducam-b0310.dtbo|\
    k3-am67a-beagley-ai-csi0-arducam-b0569-imx415-37.dtbo|\
    k3-am67a-beagley-ai-csi0-arducam-b0569-imx415-1a.dtbo)
      return 0
      ;;
  esac
  return 1
}

configured_sensor() {
  [[ -r "$CONFIG_FILE" ]] || return 1
  sed -n 's/^TI_K3_CAMERA_SELECTED=//p' "$CONFIG_FILE" | tail -n1
}

boot_camera_overlay() {
  [[ -r "$UENV_FILE" ]] || return 1
  local token base
  while IFS= read -r token; do
    [[ -n "$token" ]] || continue
    base=${token##*/}
    if known_camera_basename "$base"; then
      printf '%s\n' "$token"
      return 0
    fi
  done < <(
    sed -n 's/^[[:space:]]*name_overlays=//p' "$UENV_FILE" |
      tail -n1 |
      tr ' ' '\n'
  )
  return 1
}

active_sensor() {
  if [[ -r "$RUN_ENV" ]]; then
    sed -n 's/^TI_K3_CAMERA_DETECTED_SENSOR=//p' "$RUN_ENV" | tail -n1
    return 0
  fi

  local node name found=""
  for node in /sys/class/video4linux/v4l-subdev*; do
    [[ -r "$node/name" ]] || continue
    name=$(tr '[:upper:]' '[:lower:]' < "$node/name")
    case "$name" in
      *imx219*) found=imx219 ;;
      *imx708*) found=imx708 ;;
      *imx415*) found=imx415 ;;
      *) continue ;;
    esac
    printf '%s\n' "$found"
    return 0
  done
  return 1
}

print_status() {
  local selected overlay detected expected state
  selected=$(configured_sensor 2>/dev/null || true)
  overlay=$(boot_camera_overlay 2>/dev/null || true)
  detected=$(active_sensor 2>/dev/null || true)
  expected=""
  [[ -n "$selected" ]] && expected=$(overlay_for "$selected" 2>/dev/null || true)

  printf 'configured_sensor=%s\n' "${selected:-auto}"
  printf 'configured_overlay=%s\n' "${expected:-none}"
  printf 'boot_camera_overlay=%s\n' "${overlay:-none}"
  printf 'active_sensor=%s\n' "${detected:-none}"

  state=unknown
  if [[ -n "$selected" && -n "$expected" ]]; then
    if [[ "${overlay##*/}" != "${expected##*/}" ]]; then
      state=reboot-required
    elif [[ -n "$detected" && "$detected" != "$selected" ]]; then
      state=reboot-required
    else
      state=boot-configured
    fi
  elif [[ -n "$detected" ]]; then
    state=auto-detected
  fi
  printf 'state=%s\n' "$state"
}

write_config() {
  local sensor=$1 overlay=$2 camera_type=$3 dir tmp
  dir=$(dirname "$CONFIG_FILE")
  mkdir -p "$dir"
  tmp=$(mktemp "$dir/.camera.conf.XXXXXX")
  cat > "$tmp" <<EOF_CONFIG
# Managed by ti-k3-camera-select
TI_K3_CAMERA_SELECTED=$sensor
TI_K3_CAMERA_OVERLAY=$overlay
TI_K3_OPENHD_CAMERA_TYPE=$camera_type
EOF_CONFIG
  chmod 0644 "$tmp"
  mv -f "$tmp" "$CONFIG_FILE"
}

set_boot_overlay() {
  local target=$1
  python3 - "$UENV_FILE" "$target" <<'PY'
import os
import sys
from pathlib import Path

path = Path(sys.argv[1])
target = sys.argv[2]
known = {
    "k3-am67a-beagley-ai-csi1-imx219.dtbo",
    "k3-am67a-beagley-ai-csi0-imx219.dtbo",
    "k3-am67a-beagley-ai-csi0-arducam-b0310.dtbo",
    "k3-am67a-beagley-ai-csi0-arducam-b0569-imx415-37.dtbo",
    "k3-am67a-beagley-ai-csi0-arducam-b0569-imx415-1a.dtbo",
}

if not path.is_file():
    raise SystemExit(f"Missing boot environment file: {path}")

lines = path.read_text().splitlines()
out = []
seen = False
for line in lines:
    if line.lstrip().startswith("name_overlays="):
        if seen:
            continue
        prefix = line[: len(line) - len(line.lstrip())]
        value = line.lstrip().split("=", 1)[1]
        tokens = []
        for token in value.split():
            if Path(token).name in known:
                continue
            tokens.append(token)
        tokens.append(target)
        out.append(prefix + "name_overlays=" + " ".join(tokens))
        seen = True
    else:
        out.append(line)

if not seen:
    out.append("name_overlays=" + target)

st = path.stat()
tmp = path.with_name(path.name + ".camera-select.tmp")
tmp.write_text("\n".join(out) + "\n")
os.chmod(tmp, st.st_mode & 0o7777)
os.replace(tmp, path)
PY
}

cmd=${1:-status}
case "$cmd" in
  -h|--help) usage ;;
  list)
    printf '%-8s %-5s %s\n' SENSOR TYPE OVERLAY
    for sensor in imx219 imx708 imx415; do
      printf '%-8s %-5s %s\n' "$sensor" "$(camera_type_for "$sensor")" "$(overlay_for "$sensor")"
    done
    exit 0
    ;;
  status)
    print_status
    exit 0
    ;;
  imx219|imx708|imx415) ;;
  *) usage ;;
esac

[[ $(id -u) -eq 0 || ${TI_K3_CAMERA_ALLOW_UNPRIVILEGED:-no} == yes ]] || {
  echo 'Camera selection must run as root.' >&2
  exit 1
}

sensor=$cmd
target=$(overlay_for "$sensor")
camera_type=$(camera_type_for "$sensor")
target_path="$DTB_ROOT/$target"
[[ -s "$target_path" ]] || {
  echo "Camera overlay is not installed: $target_path" >&2
  exit 1
}
[[ -r "$UENV_FILE" && -w "$UENV_FILE" ]] || {
  echo "Boot environment is not writable: $UENV_FILE" >&2
  exit 1
}

before=$(boot_camera_overlay 2>/dev/null || true)
backup="${UENV_FILE}.pre-camera-select-$(date +%Y%m%d-%H%M%S)"
cp -a "$UENV_FILE" "$backup"

set_boot_overlay "$target"
write_config "$sensor" "$target" "$camera_type"
after=$(boot_camera_overlay 2>/dev/null || true)

[[ "${after##*/}" == "${target##*/}" ]] || {
  echo "Failed to select camera overlay; restoring $backup" >&2
  cp -a "$backup" "$UENV_FILE"
  exit 1
}

echo "Selected camera: $sensor (OpenHD type $camera_type)"
echo "Boot overlay:    $target"
echo "Backup:          $backup"
if [[ "${before##*/}" == "${target##*/}" ]]; then
  echo 'Reboot required: no (boot overlay already selected)'
else
  echo 'Reboot required: yes'
fi
