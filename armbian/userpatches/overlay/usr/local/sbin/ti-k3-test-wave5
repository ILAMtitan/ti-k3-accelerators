#!/usr/bin/env bash
set -euo pipefail
ti-k3-wave5-verify --prepare
exec gst-launch-1.0 -e -v videotestsrc is-live=true num-buffers=300 '!' \
	video/x-raw,format=NV12,width=1280,height=720,framerate=30/1,colorimetry=bt709 '!' \
	v4l2h264enc extra-controls="controls,frame_level_rate_control_enable=1,video_bitrate=3000000,video_gop_size=15" '!' \
	video/x-h264,stream-format=byte-stream,alignment=au '!' h264parse '!' fakesink sync=false
