TI_K3_SOC=j722s
TI_K3_BOARD=beagley-ai
TI_K3_MEMORY_PROFILE=j722s-beagley-ai-4gb-r73341
TI_K3_C7X_LOAD_DELAY_SECONDS=10
TI_K3_VISION_APPS_FIRMWARE_MANIFEST=/etc/ti-k3/vision-apps-firmware.sha256
TI_K3_TIOVX_DMA_HEAP=/dev/dma_heap/carveout_vision_apps_shared-memories
TI_K3_DMA_BUF_PHYS_DEVICE=/dev/dma-buf-phys
TI_K3_DMA_BUF_PHYS_MIN=0xc0000000
TI_K3_DMA_BUF_PHYS_MAX=0xe0000000
TI_K3_CAMERA_DCC_VISS=/opt/imaging/imx219/linear/dcc_viss_1920x1080.bin
TI_K3_CAMERA_DCC_2A=/opt/imaging/imx219/linear/dcc_2a_1920x1080.bin
TI_K3_CAMERA_CSI_V4L2_IO_MODE=dmabuf-import
TI_K3_CAMERA_TIOVX_SINK_POOL_SIZE=8
TI_K3_CAMERA_TIOVX_SRC_POOL_SIZE=8
