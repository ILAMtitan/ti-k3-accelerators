# J722S Split-R2 firmware reconstruction manifest
#
# Split-R2 is derived from the reconstructed Split-R1 source state and removes
# application-specific OpenHD naming.
#
# The frozen deployed Split-R2 firmware cohort is hardware-qualified. Fresh
# source rebuilds are comparison/provenance artifacts only and are not approved
# as deployment replacements unless they independently satisfy the qualified
# firmware contract.
#
# Source baseline:
#   TI Processor SDK RTOS J722S 11.02.01.03

PSDK_RTOS_VERSION=11.02.01.03
MCU_PLUS_SDK_VERSION=11_02_01_05
CANONICAL_BUILD_ROOT=/home/bart/ti-sdk-11.02.01/rtos-src

SOC=j722s
TISDK_IMAGE=edgeai
RTOS=FREERTOS
PROFILE=release
BUILD_PROFILE_LIST_ALL=release
TARGET_SOC=J722S
C7X_TARGET=C7524

CGT_ARMLLVM_VERSION=4.0.4.LTS
CGT_C7X_VERSION=5.0.0.LTS
SYSCONFIG_VERSION=1.26.2

BUILD_EDGEAI=yes
BUILD_MCU_BOARD_DEPENDENCIES=no
BUILD_ENABLE_ETHFW=no

BUILD_EMULATION_MODE=no
BUILD_TARGET_MODE=yes
BUILD_PTK=yes
ENABLE_NEW_TIDL_STRUCTURE=yes

# These variables define both what is built and the ENABLE_IPC_* topology
# compiled into Vision Apps. BUILD_CPU_MCU2_0 must remain enabled while
# building C7x images; removing it changes C7x appInit().
BUILD_CPU_MCU2_0=yes
BUILD_CPU_C7x_1=yes
BUILD_CPU_C7x_2=yes

# C7x dependency cohort reconstructed in historical order.
C7X_REBUILD_1=app_utils
C7X_REBUILD_2=tiovx
C7X_REBUILD_3=imaging
C7X_REBUILD_4=tidl_lib
C7X_REBUILD_5=ptk

# HLOS environmental requirement used by Vision Apps.
HLOS_GCC_VERSION=13.4.0

# Expected Vision Apps IPC cohort.
IPC_CORE_1=ENABLE_IPC_MPU1
IPC_CORE_2=ENABLE_IPC_MCU2_0
IPC_CORE_3=ENABLE_IPC_C7x_1
IPC_CORE_4=ENABLE_IPC_C7x_2
